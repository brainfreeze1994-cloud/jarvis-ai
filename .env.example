# H.E.N.R.Y Environment Configuration
# Copy this file to .env and fill in your actual values

# Groq API Key (for AI reasoning)
GROQ_API_KEY=your_groq_api_key_here

# Cloudflare Account ID (for Workers/Namespace)
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare API Token (with Workers edit permissions)
CF_API_TOKEN=your_cloudflare_api_token_here

# Google OAuth (for Workspace integration - Server-side)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth-callback

# Google API (for Client-side direct integration)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Custom configuration
NODE_ENV=development
PORT=3000
